# Phase 2 — single source of truth for per-session-container resource limits (FR-06).
# ---------------------------------------------------------------------------
# Every consumer MUST read this file; nothing hardcodes limit values:
#   - orchestrator/provision.sh   (docker run flags)
#   - compose/session.yml         (mem_limit / memswap_limit / cpus / pids_limit)
#   - ci/smoke.sh                 (parity assertion vs `docker inspect`)
#
# LIMIT-PARITY-TABLE (keep in sync with docs/phase2/resource-limits.md):
#   role     | memory | memory-swap | cpus | pids-limit
#   attacker | 512m   | 768m        | 1.0  | 100
#   target   | 256m   | 384m        | 0.5  | 50
#
# Rationale (PRD §5 / risk table):
#   - Swap > RAM so a msfconsole module-load spike (known OOM risk) degrades to
#     slow instead of an instant OOM-kill mid-session.
#   - [ASSUMPTION] sized from Phase 0 profiling (legacy idle pair ~88 MiB);
#     re-validate against Phase 5 after/before data before GA.
ATTACKER_MEMORY=512m
ATTACKER_MEMORY_SWAP=768m
ATTACKER_CPUS=1.0
ATTACKER_PIDS_LIMIT=100

TARGET_MEMORY=256m
TARGET_MEMORY_SWAP=384m
TARGET_CPUS=0.5
TARGET_PIDS_LIMIT=50
